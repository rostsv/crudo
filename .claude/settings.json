{
  "permissions": {
    "allow": [
      "Read(*)",
      "Grep(*)",
      "Glob(*)",
      "Edit(*.md)",
      "Edit(**/*.md)",
      "Edit(*.markdown)",
      "Edit(**/*.markdown)",
      "Edit(*.txt)",
      "Edit(**/*.txt)",
      "Edit(*.rst)",
      "Edit(**/*.rst)",
      "Write(*.md)",
      "Write(**/*.md)",
      "Write(*.markdown)",
      "Write(**/*.markdown)",
      "Write(*.txt)",
      "Write(**/*.txt)",
      "Write(*.rst)",
      "Write(**/*.rst)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Bash(file:*)",
      "Bash(which:*)",
      "Bash(pwd:*)",
      "Bash(echo:*)",
      "Bash(stat:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(jq:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(git:*)",
      "Bash(flutter:*)",
      "Bash(dart:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(cp:*.env*)",
      "Bash(cat:*.env*)"
    ]
  }
}
