{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode-go/deepseek-v4-flash",

  "skills": {
    "paths": [".agents/skills"]
  },

  "agent": {
    "ui": {
      "model": "opencode-go/kimi-k2.5",
      "instructions": [
        "./AGENTS.md",
        "./.opencode/roles/ui.md"
      ]
    },

    "implement": {
      "model": "opencode-go/minimax-m2.7",
      "instructions": [
        "./AGENTS.md",
        "./.opencode/roles/implement.md"
      ]
    },

    "build": {
      "model": "opencode-go/deepseek-v4-flash",
      "instructions": [
        "./AGENTS.md",
        "./.opencode/roles/build.md"
      ]
    },

    "review": {
      "model": "opencode-go/qwen-3.7-max",
      "mode": "subagent",
      "permission": {
        "edit": "deny"
      },
      "instructions": [
        "./AGENTS.md",
        "./.opencode/roles/review.md"
      ]
    }
  }
}