{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode-go/deepseek-v4-flash",

  "skills": {
    "paths": [".agents/skills"]
  },

  "agent": {
    "plan": {
      "model": "opencode-go/qwen3.7-max",
      "instructions": [
        "./AGENTS.md",
        "./docs/workflow.md"
      ]
    },

    "ui": {
      "model": "opencode-go/kimi-k2.6",
      "instructions": [
        "./AGENTS.md",
        "./.opencode/roles/ui.md"
      ]
    },

    "implement": {
      "model": "opencode-go/kimi-k2.6",
      "instructions": [
        "./AGENTS.md",
        "./.opencode/roles/implement.md"
      ]
    },

    "build": {
      "model": "opencode/deepseek-v4-flash-free",
      "mode": "all",
      "instructions": [
        "./AGENTS.md",
        "./.opencode/roles/build.md"
      ]
    },

    "review": {
      "model": "opencode/nemotron-3-super-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny"
      },
      "instructions": [
        "./AGENTS.md",
        "./.opencode/roles/review.md"
      ]
    },

    "escalate": {
      "model": "opencode-go/qwen3.7-max",
      "mode": "all",
      "instructions": [
        "./AGENTS.md",
        "./.opencode/roles/escalate.md"
      ]
    }
  }
}