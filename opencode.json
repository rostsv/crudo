{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode-go/deepseek-v4-flash",

  "instructions": [
    "./AGENTS.md"
  ],

  "skills": {
    "paths": [".agents/skills"]
  },

  "agent": {
    "plan": {
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "{file:./docs/workflow.md}"
    },

    "ui": {
      "model": "opencode-go/kimi-k2.6",
      "prompt": "{file:./.opencode/roles/ui.md}"
    },

    "implement-flash": {
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./.opencode/roles/implement.md}"
    },

    "implement-kimi": {
      "model": "opencode-go/kimi-k2.6",
      "prompt": "{file:./.opencode/roles/implement.md}"
    },

    "build": {
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "all",
      "prompt": "{file:./.opencode/roles/build.md}"
    },

    "review": {
      "model": "opencode-go/deepseek-v4-pro",
      "permission": {
        "edit": {
          "**": "deny",
          ".opencode/handoff/**": "allow"
        }
      },
      "prompt": "{file:./.opencode/roles/review.md}"
    },

    "escalate": {
      "model": "opencode-go/deepseek-v4-pro",
      "mode": "all",
      "prompt": "{file:./.opencode/roles/escalate.md}"
    }
  }
}